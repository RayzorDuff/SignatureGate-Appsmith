{
  "animateLoading": true,
  "borderRadius": "{{appsmith.theme.borderRadius.appBorderRadius}}",
  "bottomRow": 75,
  "boxShadow": "none",
  "buttonColor": "{{appsmith.theme.colors.primaryColor}}",
  "buttonVariant": "PRIMARY",
  "disabledWhenInvalid": false,
  "dynamicBindingPathList": [
    {
      "key": "isVisible"
    },
    {
      "key": "isDisabled"
    },
    {
      "key": "buttonColor"
    },
    {
      "key": "borderRadius"
    }
  ],
  "dynamicPropertyPathList": [
    {
      "key": "onClick"
    }
  ],
  "dynamicTriggerPathList": [
    {
      "key": "onClick"
    }
  ],
  "isDefaultClickDisabled": true,
  "isDisabled": "{{ !selTerminologyConcept.selectedOptionValue || !(inpTermSingular.text || '').trim() || !(inpTermPlural.text || '').trim() || !(inpTermReason.text || '').trim() }}",
  "isLoading": false,
  "isVisible": "{{ qTerminologyAccess.data?.[0]?.allowed === true }}",
  "key": "term-save",
  "leftColumn": 0,
  "minWidth": 120,
  "mobileBottomRow": 30,
  "mobileLeftColumn": 0,
  "mobileRightColumn": 7,
  "mobileTopRow": 26,
  "needsErrorInfo": false,
  "onClick": "{{ (async()=>{ try { const rows = await qSetTerminology.run(); await qTerminology.run(); showAlert(rows?.[0]?.changed ? 'Terminology updated.' : 'No terminology changes were needed.', 'success'); } catch (e) { showAlert(`Unable to save terminology: ${e?.message || e}`, 'error'); } })() }}",
  "originalBottomRow": 97,
  "originalTopRow": 90,
  "parentColumnSpace": 10.25,
  "parentId": "0",
  "parentRowSpace": 10,
  "placement": "CENTER",
  "recaptchaType": "V3",
  "renderMode": "CANVAS",
  "resetFormOnClick": false,
  "responsiveBehavior": "hug",
  "rightColumn": 28,
  "text": "Save terminology",
  "topRow": 68,
  "type": "BUTTON_WIDGET",
  "version": 1,
  "widgetId": "term-save",
  "widgetName": "btnSaveTerminology"
}