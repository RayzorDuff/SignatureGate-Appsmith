      "onClick": "{{ navigateTo(\"Member Functions\",{member_id:(qNavigationAccess.data?.[0]?.is_document_reviewer || qNavigationAccess.data?.[0]?.is_practitioner)?'':qNavigationAccess.data?.[0]?.member_id || ''},\"SAME_WINDOW\") }}"
