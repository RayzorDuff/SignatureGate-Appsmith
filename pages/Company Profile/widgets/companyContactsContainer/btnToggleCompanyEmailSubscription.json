  "responsiveBehavior": "hug",
  "rightColumn": 64,
  "text": "{{ (()=>{ const c=(qCompanyDonorContacts.data||[]).find(x=>x.contact_id===selCompanyDonorContactToArchive.selectedOptionValue&&x.contact_kind==='email');if(!c)return 'Mailing subscription';return c.mailing_subscription_status==='subscribed'?'Unsubscribe (currently subscribed)':'Subscribe (currently unsubscribed)';})() }}",
