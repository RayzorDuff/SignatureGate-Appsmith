  "needsErrorInfo": false,
  "onClick": "{{ (async () => { try { const row=(qCompanyDonorContacts.data||[]).find(c=>c.contact_id===selCompanyDonorContactToArchive.selectedOptionValue&&c.contact_kind==='email'); if(!row) {showAlert('Select an email first.','warning');return;} const r=await qToggleCompanyEmailSubscription.run(); if(!r?.[0]?.queue_id) throw new Error('Listmonk synchronization was not queued.');await Promise.all([qCompanyDonorContacts.run(),qCompanyContacts.run()]);showAlert(r[0].mailing_subscription_status==='subscribed'?'Contributor subscription queued.':'Contributor unsubscribe queued.','success');}catch(e){showAlert('Mailing subscription change failed: '+(e?.message||e),'error');} })() }}",
